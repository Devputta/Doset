# --- Auth ---------------------------------------------------------------
# MUST match the frontend's SESSION_SECRET exactly (doc-assistant/.env.local).
# The backend verifies the same HS256 JWT the frontend issues — it never
# issues or stores sessions itself.
SESSION_SECRET=replace-with-a-long-random-string

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Origins allowed to call the API directly (browser -> FastAPI). Not needed
# for the default setup, where Next.js proxies server-side, but useful if
# you point NEXT_PUBLIC_APP_URL's frontend straight at this API in dev.
CORS_ORIGINS=http://localhost:3000

# --- Storage ---------------------------------------------------------------
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_PATH=./data/app.db
MAX_FILE_SIZE_MB=25

# --- Chunking ---------------------------------------------------------------
# Approximate token counts; converted to characters internally (~4 chars/token).
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# --- Embeddings ---------------------------------------------------------------
# "openai" or "gemini"
EMBEDDING_PROVIDER=openai
# openai: text-embedding-3-small | gemini: text-embedding-004
EMBEDDING_MODEL=text-embedding-3-small

# --- LLM ---------------------------------------------------------------
# "openai", "anthropic", or "gemini"
LLM_PROVIDER=openai
# openai: gpt-4o-mini | anthropic: claude-3-5-haiku-20241022 | gemini: gemini-2.5-flash
LLM_MODEL=gpt-4o-mini
RETRIEVAL_TOP_K=5

# --- Provider API keys (never hardcode these; never expose them to the frontend) ---
# You only need the key(s) for the provider(s) you actually selected above.
#
# OPENAI_API_KEY / ANTHROPIC_API_KEY: paid, per-token billing.
# GEMINI_API_KEY: has a genuine free tier, no credit card required —
#   create one at https://aistudio.google.com/apikey. To run this project
#   entirely free, set EMBEDDING_PROVIDER=gemini, LLM_PROVIDER=gemini,
#   EMBEDDING_MODEL=text-embedding-004, LLM_MODEL=gemini-2.5-flash, and only
#   fill in GEMINI_API_KEY below. The free tier is rate-limited (fine for
#   trying this project out, not for production traffic).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
