# Used by `docker-compose.yml` only. For running the two services directly
# with `npm run dev` / `uvicorn`, use doc-assistant/.env.local and
# backend/.env instead (see the root INSTALL.md).
#
# Never commit a real .env with actual secrets — only this .env.example.

# --- Shared auth secret --------------------------------------------------
# Signs/verifies the session JWT. Must be identical for the frontend and
# backend to agree on who's logged in. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# --- LLM / embeddings (backend) ------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GEMINI_API_KEY has a genuine free tier (no credit card) — see
# backend/.env.example for how to run this project on Gemini only.
GEMINI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- Google OAuth (frontend "Sign in with Google") ------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URLs -------------------------------------------------------------------
# The public URL people load in a browser (used for OAuth redirect URIs,
# password-reset links, etc.).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Upload / chunking tuning (backend) ------------------------------------
MAX_FILE_SIZE_MB=25
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# --- CORS (backend) -----------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Notes on names you'll see referenced elsewhere:
#
# - DATABASE_URL: this project uses SQLite (a file inside the `backend_data`
#   Docker volume, or backend/data/app.db locally) rather than a networked
#   database, so there's no connection string to set. See backend/README.md
#   for how to swap in Postgres if you outgrow SQLite.
# - CHROMA_HOST / CHROMA_PORT: set automatically by docker-compose.yml to
#   point the backend at the `chroma` service — you don't need to set these
#   yourself unless you're running Chroma as its own service outside Compose.
# - NEXT_PUBLIC_API_URL: not used. The browser never calls the FastAPI
#   backend directly — every request goes through a Next.js API route that
#   forwards it server-side (see doc-assistant/src/lib/backend-proxy.ts).
#   The backend's address is configured with API_BASE_URL, which is a
#   server-only variable and is set directly in docker-compose.yml for the
#   `frontend` service (http://backend:8000), not here.
# ---------------------------------------------------------------------------
